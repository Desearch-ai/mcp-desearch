# Copy to .env for a local HTTP server. Do not commit real secrets.

# Canonical origin, no trailing slash. Required when NODE_ENV=production or VERCEL is set.
# OAUTH_ISSUER=https://mcp.desearch.ai

# Canonical MCP resource. Default is {OAUTH_ISSUER}/mcp.
# OAUTH_RESOURCE=https://mcp.desearch.ai/mcp

# memory (local default) or redis. Production and Vercel require redis.
OAUTH_STORE=memory

# Required when OAUTH_STORE=redis.
# REDIS_URL=rediss://default:password@host:6379

# 32-byte key, base64 or hex. Required when OAUTH_STORE=redis.
# Generate with: openssl rand -base64 32
# OAUTH_ENCRYPTION_KEY=

# Lifetimes in seconds.
# OAUTH_ACCESS_TTL_SEC=3600
# OAUTH_REFRESH_TTL_SEC=2592000
# OAUTH_CODE_TTL_SEC=300
# Dynamic client registration lifetime. Default 90 days (7776000). Range 3600 to 5 years.
# OAUTH_CLIENT_TTL_SEC=7776000

# Per-IP fixed windows. Over the limit, the response is 429 with Retry-After.
# On Vercel the client address is the first X-Forwarded-For hop.
# Registration: 10 requests per hour per IP.
# OAUTH_REGISTER_RATE_LIMIT=10
# OAUTH_REGISTER_RATE_WINDOW_SEC=3600
# Sign-in key check: 20 requests per 10 minutes per IP.
# OAUTH_AUTHORIZE_RATE_LIMIT=20
# OAUTH_AUTHORIZE_RATE_WINDOW_SEC=600

# Key check host. Default https://api.desearch.ai
# DESEARCH_API_BASE=https://api.desearch.ai

# Set to true to require a key or access token on initialize. tools/list stays public.
# OAUTH_REQUIRE_AUTH_ON_INITIALIZE=false

# Stdio only. The hosted HTTP server does not read this for incoming requests.
# DESEARCH_API_KEY=
