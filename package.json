{
    "name": "desearch-mcp-server",
    "version": "0.2.1",
    "mcpName": "io.github.Desearch-ai/mcp-desearch",
    "description": "AI search (web, Reddit, Hacker News, arXiv, Wikipedia, and Twitter), X (Twitter) search, web search, page extraction, X data, and People Search (find people and creators on X, YouTube, LinkedIn, and TikTok) tools for AI agents.",
    "license": "MIT",
    "homepage": "https://desearch.ai",
    "type": "module",
    "author": "Desearch AI",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Desearch-ai/mcp-desearch.git"
    },
    "bugs": {
        "url": "https://github.com/Desearch-ai/mcp-desearch/issues"
    },
    "bin": {
        "desearch-mcp-server": "./build/index.js"
    },
    "files": [
        "build",
        "CHANGELOG.md"
    ],
    "keywords": [
        "mcp",
        "mcp-server",
        "model-context-protocol",
        "desearch",
        "ai-search",
        "web-search",
        "x-search",
        "twitter-search",
        "search-api",
        "bittensor",
        "subnet-22",
        "ai-agents",
        "llm",
        "claude",
        "cursor",
        "reddit",
        "hackernews",
        "arxiv",
        "wikipedia",
        "people-search",
        "creator-search",
        "influencer-search",
        "lead-generation",
        "youtube",
        "tiktok",
        "linkedin"
    ],
    "scripts": {
        "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
        "start:http": "node build/index.js --http",
        "test": "npm run build && node --test test/*.test.mjs",
        "inspector": "npx @modelcontextprotocol/inspector build/index.js",
        "prepare": "npm run build",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.1",
        "desearch-js": "^1.5.0",
        "redis": "^5.12.1",
        "undici": "^7.29.1",
        "zod": "^3.24.4"
    },
    "devDependencies": {
        "@types/node": "^20.14.8",
        "typescript": "^5.8.3"
    },
    "engines": {
        "node": ">=20.18.1"
    },
    "overrides": {
        "undici": "$undici"
    }
}
