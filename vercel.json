{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "npm run build",
    "rewrites": [
        { "source": "/", "destination": "/api/health" },
        { "source": "/health", "destination": "/api/health" },
        { "source": "/mcp", "destination": "/api/mcp" },
        { "source": "/mcp/", "destination": "/api/mcp" },
        { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth-protected-resource" },
        { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/oauth-protected-resource-mcp" },
        { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth-authorization-server" },
        { "source": "/.well-known/openid-configuration", "destination": "/api/openid-configuration" },
        { "source": "/.well-known/openai-apps-challenge", "destination": "/api/openai-apps-challenge" },
        { "source": "/.well-known/agent-tools-verify.txt", "destination": "/api/agent-tools-verify" },
        { "source": "/.well-known/agent-tools.txt", "destination": "/api/agent-tools" },
        { "source": "/register", "destination": "/api/oauth-register" },
        { "source": "/authorize", "destination": "/api/oauth-authorize" },
        { "source": "/token", "destination": "/api/oauth-token" }
    ],
    "headers": [
        {
            "source": "/icon-512.png",
            "headers": [
                { "key": "Content-Type", "value": "image/png" },
                { "key": "Cache-Control", "value": "public, max-age=86400" },
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
            ]
        },
        {
            "source": "/icon-64.png",
            "headers": [
                { "key": "Content-Type", "value": "image/png" },
                { "key": "Cache-Control", "value": "public, max-age=86400" },
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
            ]
        },
        {
            "source": "/favicon.png",
            "headers": [
                { "key": "Content-Type", "value": "image/png" },
                { "key": "Cache-Control", "value": "public, max-age=86400" },
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
            ]
        },
        {
            "source": "/favicon.ico",
            "headers": [
                { "key": "Content-Type", "value": "image/x-icon" },
                { "key": "Cache-Control", "value": "public, max-age=86400" },
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
            ]
        }
    ],
    "functions": {
        "api/mcp.js": {
            "maxDuration": 60
        }
    }
}
